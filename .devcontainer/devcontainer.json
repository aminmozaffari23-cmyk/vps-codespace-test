{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Ultimate VPS Codespace (systemctl, iptables, WireGuard, FUSE, Nginx, OpenCode)",

  "build": {
    "dockerfile": "Dockerfile"
  },

  // =========================================================================
  // 1. VPS PRIVILEGES & RUNTIME
  // =========================================================================
  // privileged: true grants full raw hardware and kernel capabilities
  "privileged": true,

  // Direct root access
  "remoteUser": "root",

  // =========================================================================
  // 2. RUN ARGS: SHM-SIZE, ULIMITS & TRACING
  // =========================================================================
  "runArgs": [
    // [SHARED MEMORY]: Expand /dev/shm from default 64MB to 4GB (prevents browser/ML/build crashes)
    "--shm-size=4g",

    // [ULIMITS]: Increase open file and process limits (essential for servers/compilers)
    "--ulimit", "nofile=65535:65535",
    "--ulimit", "nproc=65535:65535",

    // [CAPABILITIES]: Network administration, sysadmin, process tracing
    "--cap-add=NET_ADMIN",
    "--cap-add=SYS_ADMIN",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined"
  ],

  // =========================================================================
  // 3. PERSISTENT STORAGE (Survives full container rebuilds!)
  // =========================================================================
  "mounts": [
    // Dedicated persistent storage for databases, downloads, or custom files
    "source=codespace-vps-data,target=/data,type=volume",
    // Docker volume cache (preserves pulled docker images across rebuilds)
    "source=codespace-vps-docker,target=/var/lib/docker,type=volume"
  ],

  // =========================================================================
  // 4. MODULAR FEATURES (Toggle ON/OFF)
  // =========================================================================
  "features": {
    // Docker-in-Docker: Full embedded Docker daemon
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true"
    },

    // SSH Server on port 2222
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest",
      "port": "2222"
    },

    // GitHub CLI tool pre-authenticated
    "ghcr.io/devcontainers/features/github-cli:1": {},

    // Node.js LTS Runtime
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },

    // Zsh + sysadmin cli enhancements
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "true",
      "configureZshAsDefaultShell": "true"
    }
  },

  // Recommended hardware specs
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb",
    "gpu": "optional"
  },

  // Environment variables inside container
  "containerEnv": {
    "DEBIAN_FRONTEND": "noninteractive",
    "CODESPACE_ROLE": "vps",
    "TZ": "UTC",
    "GITHUB_USER": "aminmozaffari23-cmyk"
  },

  // =========================================================================
  // 5. NETWORKING & PORT FORWARDING
  // =========================================================================
  "forwardPorts": [
    2222, // SSH daemon
    80,   // HTTP Web server (Nginx)
    443,  // HTTPS Web server
    3000, // Dev web server
    8080  // Custom API backend
  ],

  "portsAttributes": {
    "80": {
      "label": "Web Server (HTTP)",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "443": {
      "label": "Web Server (HTTPS)",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "3000": {
      "label": "App Port 3000",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "8080": {
      "label": "API Port 8080",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "2222": {
      "label": "SSH Server",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },

  // =========================================================================
  // 6. LIFECYCLE SCRIPTS
  // =========================================================================
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-services.sh",

  // =========================================================================
  // 7. CUSTOMIZATIONS
  // =========================================================================
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        ".devcontainer/devcontainer.json"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
